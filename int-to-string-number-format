public class Teste {
    public static String returnNumber(int[] number) {

        String numeroStr = "";

        for(int i = 0; i < number.length; i++) {

            numeroStr = numeroStr + String.valueOf(number[i]);
        }

        String ddd = numeroStr.substring(0,3);
        String part1 = numeroStr.substring(3,6);
        String part2 = numeroStr.substring(6,10);

        return String.format("(%s) %s-%s", ddd, part1, part2);
    }
        public static void main (String[]args) {

            int[] valores = {1,2,3,4,5,6,7,8,9,0};

            System.out.print(returnNumber(valores));
            
    }
}
